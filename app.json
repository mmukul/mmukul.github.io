{
  "expo": {
    "name": "NextGen DevSecOps AI",
    "slug": "nextgen-devsecops-ai",
    "version": "1.1.1",
    "orientation": "portrait",
    "scheme": "nextgendevsecops",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#071329"
        }
      ]
    ],
    "android": {
      "package": "in.nextgendevsecops.app",
      "versionCode": 11,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#071329"
      }
    },
    "ios": {
      "bundleIdentifier": "in.nextgendevsecops.app",
      "buildNumber": "11",
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "tez",
          "phonepe",
          "paytmmp"
        ]
      }
    },
    "extra": {
      "router": {}
    },
    "description": "Practical DevOps, DevSecOps, Application Security, GenAI and AI Security training with hands-on learning, curriculum access, student portal and secure course enrolment.",
    "web": {
      "output": "static",
      "name": "NextGen DevSecOps AI",
      "description": "Practical DevOps, DevSecOps, AppSec, GenAI and AI Security training, hands-on labs, curriculum access and secure course enrolment.",
      "themeColor": "#071329"
    }
  }
}
